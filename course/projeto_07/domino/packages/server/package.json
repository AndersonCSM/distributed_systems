{
  "name": "@domino-online/server",
  "version": "0.1.0",
  "description": "Backend do jogo de Dominó Online",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts"
  },
  "keywords": ["domino", "game", "socket.io", "realtime"],
  "author": "Domino Online Team",
  "license": "MIT",
  "dependencies": {
    "express": "4.18.2",
    "socket.io": "4.7.2",
    "cors": "2.8.5",
    "dotenv": "16.3.1",
    "@aws-sdk/client-sqs": "latest",
    "uuid": "9.0.1"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "20.10.6",
    "@types/cors": "2.8.17",
    "@types/uuid": "9.0.7",
    "typescript": "5.3.3",
    "tsx": "4.7.0"
  }
}
