# Environment
NODE_ENV=development

# Server
PORT=3001
HOST=0.0.0.0
CLIENT_URL=http://localhost:5173

# Game Config
GAME_MODE=classico
MIN_PLAYERS=2
MAX_PLAYERS=4
PIECES_PER_PLAYER=7

# Logging
LOG_LEVEL=debug

# AWS SQS Configuration (Para sincronização distribuída)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/ACCOUNT_ID/domino-queue
